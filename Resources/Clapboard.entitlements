<plist version="1.0">
<dict>
    <!--
        Clapboard runs unsandboxed and without the hardened runtime on
        purpose: it hosts third-party Audio Unit (AUv2) plug-ins in-process,
        which library validation would block. Keep this dictionary empty.
    -->
</dict>
</plist>
